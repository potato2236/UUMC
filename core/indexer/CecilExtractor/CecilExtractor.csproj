<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CecilExtractor</AssemblyName>
    <RootNamespace>Uumc.Indexer.CecilExtractor</RootNamespace>
  </PropertyGroup>

  <!-- При наличии BepInEx/core используем системный Mono.Cecil из игры; иначе — NuGet-пакет -->
  <ItemGroup Condition="Exists('$(ResolvedUumcBepInExCoreDir)\Mono.Cecil.dll')">
    <Reference Include="Mono.Cecil">
      <HintPath>$(ResolvedUumcBepInExCoreDir)\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Mono.Cecil.Rocks" Condition="Exists('$(ResolvedUumcBepInExCoreDir)\Mono.Cecil.Rocks.dll')">
      <HintPath>$(ResolvedUumcBepInExCoreDir)\Mono.Cecil.Rocks.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(ResolvedUumcBepInExCoreDir)\Mono.Cecil.dll')">
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>

</Project>
